APP_ENV=dev
HOST=127.0.0.1
PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/kuikly
DB_USER=kuikly
DB_PASSWORD=
DB_POOL_SIZE=8
DB_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_SECONDS=5
DB_MIGRATION_TIMEOUT_SECONDS=300
AUTH_SIGNING_KEY=
AUTH_RETRY_KEY=
AUTH_ISSUER=kuikly-server
AUTH_AUDIENCE=kuikly-client
AUTH_ACCESS_SECONDS=900
AUTH_SESSION_SECONDS=2592000
AUTH_GRACE_SECONDS=10
API_DOCS_ENABLED=

# Separate admin authentication domain (disabled by default).
ADMIN_ENABLED=false
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_SECRET_KEY=
ADMIN_IDLE_SECONDS=1800
ADMIN_SESSION_SECONDS=43200
