                  "format": "uuid"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "headers": {
              "X-Request-ID": {
                "description": "服务端生成的请求关联 ID；不同于客户端刷新 requestId。",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "内部错误，不泄露实现细节",
            "headers": {
              "X-Request-ID": {
                "description": "服务端生成的请求关联 ID；不同于客户端刷新 requestId。",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "短期 HS256 Access Token；服务端同时检查用户与会话状态。"
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true,
            "description": "登录接受既有密码；创建账号时要求至少十五个字符。"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken",
          "requestId"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43,
            "writeOnly": true
          },
          "requestId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "sessionId",
          "tokenType"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1800
          },
          "sessionId": {
            "$ref": "#/components/schemas/Id"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "description": "客户端需为未来新增角色保留未知值兜底。"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "稳定业务错误码，例如 INVALID_REQUEST、INVALID_CREDENTIALS、INVALID_REFRESH、REFRESH_REUSED、LOGIN_THROTTLED、AUTH_BUSY、FORBIDDEN、USER_NOT_FOUND、INTERNAL_ERROR。"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "traceId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          }
        }
      }
    }
  }
}
